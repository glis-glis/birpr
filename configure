#!/bin/sh

# Inspired from: https://cloud.r-project.org/doc/manuals/r-devel/R-exts.html#Using-cmake-1

# Define project
repoName=birp_cpp
commit=bd4782322fe4a9eb3755130a4c46203a2d4376f3

# Find C++
CXX17=`"${R_HOME}/bin/R" CMD config CXX17`
echo $CXX17
if test -z "$CXX17"; then
  echo "No C++17 compiler is available"
fi
CXX17STD=`"${R_HOME}/bin/R" CMD config CXX17STD`
CXX="${CXX17} ${CXX17STD}"
CXXFLAGS=`"${R_HOME}/bin/R" CMD config CXX17FLAGS`

# Find R
: ${R_HOME=`R RHOME`}
if test -z "${R_HOME}"; then
  echo "could not determine R_HOME"
  exit 1
fi

# Set compilation path
CC=`"${R_HOME}/bin/R" CMD config CC`
CFLAGS=`"${R_HOME}/bin/R" CMD config CFLAGS`
CPPFLAGS=`"${R_HOME}/bin/R" CMD config CPPFLAGS`
LDFLAGS=`"${R_HOME}/bin/R" CMD config LDFLAGS`

# Find CMake (for Mac)
if test -z "$CMAKE"; then CMAKE="`which cmake`"; fi
if test -z "$CMAKE"; then CMAKE=/Applications/CMake.app/Contents/bin/cmake; fi
if [ ! -f "$CMAKE" ]; then echo "no ‘cmake’ command found"; exit 1; fi

# Clone repository
cd src/
if [ -d $repoName ]; then
        echo "Already exists: `pwd`"
else
  # Get URL from bitbucket: birp_cpp -> Downloads -> Branches -> master -> gz
  wget https://bitbucket.org/wegmannlab/${repoName}/get/${commit}.tar.gz
  tar -xvzf ${commit}.tar.gz
  
  # Move contents to $repoName
  mkdir $repoName
  extracted_dir=$(tar -tzf ${commit}.tar.gz | head -n1)
  mv ${extracted_dir}* $repoName
  rm -r $extracted_dir

	# Run CMake
	cd $repoName && mkdir -p build && cd build
	${CMAKE} -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS:bool=OFF -DCMAKE_POSITION_INDEPENDENT_CODE:bool=ON -DRCPP=ON -DPARALLEL=OFF -G "Unix Makefiles" .. > cmake_log.txt
	cat cmake_log.txt
	
	# Make
	make coreLib
	cd ../../
fi


# Get Armadillo libraries from cmake output
arma_libs=$(cat ${repoName}/build/cmake_log.txt | grep ARMA_LIBS | cut -d "=" -f2 | cut -d ' ' -f2- | sed 's/;/ /g')

# Write Makevars
cat Makevars.in | sed "s|XXXARMALIBSXXX|$arma_libs|g" > Makevars

cd ..
