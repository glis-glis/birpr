
repoName=birp

PKG_CPPFLAGS = -I${repoName}/coretools/core/ \
-I${repoName}/coretools/fast_float/include/ \
-I${repoName}/coretools/fmt/include/ \
-I${repoName}/coretools/json/include/ \
-I${repoName}/coretools/armadillo/include/ \
-I${repoName}/stattools/core/ \
-I${repoName}/core/ \
-DUSE_RCPP


PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)


PKG_LIBS    =  -L${repoName}/build -lcoreLib \
-L${repoName}/build/_deps/stattools-build -lstattools \
-L${repoName}/build/_deps/coretools-build -lcoretools \
-L${repoName}/build/_deps/fmt-build -lfmt \
-L${repoName}/build/_deps/armadillo-build/tmp/include/ -larmadillo \
$(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) $(SHLIB_OPENMP_CXXFLAGS) \
XXXARMALIBSXXX
