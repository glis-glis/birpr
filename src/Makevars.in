CMAKE = @cmake@
RCPP_INCLUDE = @rcpp_include@

repoName = birp_cpp
commit = 2f8b479

PKG_CPPFLAGS = -I${repoName}/coretools/core/ \
-I${repoName}/coretools/fast_float/include/ \
-I${repoName}/stattools/core/ \
-I${repoName}/core/ \
-DUSE_RCPP

PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)

PKG_LIBS    = -L${repoName} -lbirpLib -lstattools -lcoretools -larmadillo \
$(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) $(SHLIB_OPENMP_CXXFLAGS)

.Phony: all

all: $(repoName) $(SHLIB)

$(SHLIB): $(repoName)

$(repoName):
	wget -v https://bitbucket.org/wegmannlab/${repoName}/get/${commit}.tar.gz && \
	tar -xvzf ${commit}.tar.gz && \
	rm -r ${commit}.tar.gz && \
	mv -v wegmannlab-birp_cpp* ${repoName} && \
	mkdir ${repoName}/build && cd ${repoName}/build && \
	${CMAKE} -S .. \
	-DCMAKE_BUILD_TYPE=Release \
	-DBUILD_SHARED_LIBS:bool=OFF \
	-DCMAKE_POSITION_INDEPENDENT_CODE:bool=ON \
	-DRCPP=ON \
	-DRCPP_INCLUDE_DIRS="${RCPP_INCLUDE}" \
	-DR_HOME="${R_HOME}"  && \
	make birpLib && \
	mv libbirpLib.* .. && \
	mv _deps/coretools-build/libcoretools.* .. && \
	mv _deps/stattools-build/libstattools.* .. && \
	cd .. && \
	rm -rf build coretools/tests stattools/tests coretools/fast_float/tests \
	coretools/.* stattools/.*  coretools/fast_float/.* \
	coretools/fast_float/benchmarks coretools/fast_float/fuzz
