CMAKE = cmake

REPONAME = birp_cpp
# get commit number
-include git_commit

PKG_CPPFLAGS = -I$(REPONAME)\coretools\core\ \
-I$(REPONAME)\coretools\fast_float\include\ \
-I$(REPONAME)\coretools\arma\include\ \
-I$(REPONAME)\stattools\core\ \
-I$(REPONAME)\core\ \
-DUSE_RCPP

PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)

# Include ARMA_LIBS after it's generated
-include $(REPONAME)\arma.libs
-include $(REPONAME)\rcpp.include

PKG_LIBS = -L$(REPONAME) -lbirpLib -lcoretools -lstattools -larmadillo \
$(ARMA_LIBS) $(FLIBS) $(SHLIB_OPENMP_CXXFLAGS)

.Phony: all

all: $(REPONAME) $(SHLIB)

$(SHLIB): $(REPONAME) $(REPONAME)\arma.libs

$(REPONAME)\arma.libs: $(REPONAME)\build\cmake.log
	echo ARMA_LIBS = $(grep ARMA_LIBS $< | cut -d "=" -f2 | cut -d ' ' -f2- | sed 's/;/ /g')

$(REPONAME)\build\cmake.log: $(REPONAME)

$(REPONAME): $(REPONAME)\rcpp.include
	powershell -Command "Invoke-WebRequest -Uri https://bitbucket.org/wegmannlab/$(REPONAME)/get/$(GIT_COMMIT).tar.gz -OutFile $(GIT_COMMIT).tar.gz -ErrorAction SilentlyContinue || Invoke-WebRequest -Uri https://bitbucket.org/wegmannlab/$(REPONAME)/get/$(GIT_COMMIT).tar.gz -OutFile $(GIT_COMMIT).tar.gz -ErrorAction SilentlyContinue"
	tar -xvzf $(GIT_COMMIT).tar.gz
	rm -r $(GIT_COMMIT).tar.gz
	mv -v wegmannlab-birp_cpp* $(REPONAME)
	mkdir $(REPONAME)\build
	cd $(REPONAME)\build
	$(CMAKE) -S .. -G "NMake Makefiles" -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS:bool=OFF -DCMAKE_POSITION_INDEPENDENT_CODE:bool=ON -DRCPP=ON -DRCPP_INCLUDE_DIRS="$(RCPP_INCLUDE)" -DR_HOME="$(R_HOME)" > cmake.log
	sed -i '/^#pragma/d' ../coretools/fast_float/include/fast_float/parse_number.h
	echo ARMA_LIBS = $(grep ARMA_LIBS cmake.log | cut -d "=" -f2 | cut -d ' ' -f2- | sed 's/;/ /g') > ../arma.libs
	nmake birpLib
	mv -v libbirpLib.* ..
	mv -v _deps\coretools-build\libcoretools.* ..
	mv -v _deps\stattools-build\libstattools.* ..
	mv -v _deps\armadillo-build\libarmadillo.* ..
	cd ..
	rm -rf build
	rm -rf coretools\tests stattools\tests coretools\.* stattools\.*
	rm -rf coretools\fast_float\tests coretools\fast_float\.*
	rm -rf coretools\fast_float\benchmarks coretools\fast_float\fuzz
	rm -rf coretools\arma\tests? coretools\arma\examples
	rm -rf coretools\arma\misc coretools\*.pdf
	rm -rf coretools\fmt\test coretools\fmt\.*
	cat arma.libs

$(REPONAME)\rcpp.include:
	powershell -Command "$R_HOME = $(R_HOME); $R_ARCH_BIN = $(R_ARCH_BIN); $Rscript = \"$R_HOME\bin\$R_ARCH_BIN\Rscript.exe\"; & $Rscript --vanilla --slave -e \"stopifnot(require('Rcpp', quietly=TRUE));cat(Rcpp:::Rcpp.system.file('include'))\""
	echo RCPP_INCLUDE = $(powershell -Command "$R_HOME = $(R_HOME); $R_ARCH_BIN = $(R_ARCH_BIN); $Rscript = \"$R_HOME\bin\$R_ARCH_BIN\Rscript.exe\"; & $Rscript --vanilla --slave -e \"stopifnot(require('Rcpp', quietly=TRUE));cat(Rcpp:::Rcpp.system.file('include'))\"") > $(REPONAME)\rcpp.include
